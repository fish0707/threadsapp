# ────────────────────────────────────────────────────────────────
# 脈脈 Threads 助手 — 環境變數範本
# 複製成 .env.local 後填入金鑰。任何一組沒填，該功能會自動切換成 mock 模式，
# 整個 app 仍可啟動並操作（資料以記憶體暫存，重啟即清空）。
# ────────────────────────────────────────────────────────────────

# ── AI 生成：Gemini（主力）──────────────────────────────────────
# 沒填 → 生成走 mock，回傳依風格的範例草稿。
GEMINI_API_KEY=
# 可選，預設 gemini-2.0-flash
GEMINI_MODEL=gemini-2.0-flash

# ── AI 生成：Claude（高品質模式，選用）─────────────────────────
# 沒填 → 前端仍可選「高品質模式」，但會自動回退到 Gemini / mock。
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-sonnet-4-6

# ── 資料庫：Supabase ───────────────────────────────────────────
# 兩個都沒填 → 改用記憶體暫存（單機 demo 可用，不會跨重啟保存）。
NEXT_PUBLIC_SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=

# ── Threads OAuth（推薦：點按鈕登入授權，自動換長效 token 並續期）──
# 設了 APP_ID + APP_SECRET → 首頁出現「連結 Threads 帳號」按鈕。
# 記得到 Meta → Threads 使用案例 → 設定，把 redirect uri 加入白名單：
#   https://你的網域/api/auth/threads/callback
THREADS_APP_ID=
THREADS_APP_SECRET=
# 可選：明確指定 redirect uri（不填會用 請求網域 + /api/auth/threads/callback）
THREADS_REDIRECT_URI=

# ── Threads 後備：手動單帳號 token（選用）──────────────────────
# 若不想用 OAuth，也可手動貼長效 token。OAuth 存的 token 優先。
THREADS_ACCESS_TOKEN=
# 手動 token 時的 Threads user id（發佈用），沒填會用 "me"
THREADS_USER_ID=
# Graph API 版本，預設 v1.0（Threads API）
THREADS_API_VERSION=v1.0

# ── Token 靜態加密（建議，正式環境必設）──────────────────────
# 設了就用 AES-256-GCM 加密後存 DB。可用 `openssl rand -hex 32` 產生。
TOKEN_ENCRYPTION_KEY=

# ── 快取設定 ───────────────────────────────────────────────────
# 同主題快取小時數，預設 24
TOPIC_CACHE_HOURS=24
