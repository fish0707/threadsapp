# ────────────────────────────────────────────────────────────────
# 脈脈 Threads 助手 — 環境變數範本
# 複製成 .env.local 後填入金鑰。任何一組沒填，該功能會自動切換成 mock 模式，
# 整個 app 仍可啟動並操作（資料以記憶體暫存，重啟即清空）。
# ────────────────────────────────────────────────────────────────

# ── AI 生成：Gemini（主力）──────────────────────────────────────
# 沒填 → 生成走 mock，回傳依風格的範例草稿。
GEMINI_API_KEY=
# 可選，預設 gemini-2.0-flash
GEMINI_MODEL=gemini-2.0-flash

# ── AI 生成：Claude（高品質模式，選用）─────────────────────────
# 沒填 → 前端仍可選「高品質模式」，但會自動回退到 Gemini / mock。
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-sonnet-4-6

# ── 資料庫：Supabase ───────────────────────────────────────────
# 兩個都沒填 → 改用記憶體暫存（單機 demo 可用，不會跨重啟保存）。
NEXT_PUBLIC_SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=

# ── Threads 官方 API（Phase 1 自用：單帳號 token）──────────────
# 沒填 → 搜尋與發佈走 mock。Phase 2 會改成多使用者 OAuth 授權。
THREADS_ACCESS_TOKEN=
# 你的 Threads user id（發佈用），沒填會用 "me"
THREADS_USER_ID=
# Graph API 版本，預設 v1.0（Threads API）
THREADS_API_VERSION=v1.0

# ── 快取設定 ───────────────────────────────────────────────────
# 同主題快取小時數，預設 24
TOPIC_CACHE_HOURS=24
